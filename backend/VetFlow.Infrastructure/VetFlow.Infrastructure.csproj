<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VetFlow.Infrastructure</RootNamespace>
    <AssemblyName>VetFlow.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetFlow.Application\VetFlow.Application.csproj" />
    <ProjectReference Include="..\VetFlow.Domain\VetFlow.Domain.csproj" />
    <ProjectReference Include="..\VetFlow.Shared\VetFlow.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core — provider-neutral core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- SQLite — local development only (DATABASE-PROVIDER-POLICY) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />

    <!-- PostgreSQL — CI / staging / production (DATABASE-PROVIDER-POLICY) -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />

    <!-- Keycloak / OIDC integration -->
    <PackageReference Include="Keycloak.AuthServices.Authentication" Version="2.*" />
    <PackageReference Include="Keycloak.AuthServices.Authorization" Version="2.*" />

    <!-- MinIO / S3 object storage -->
    <PackageReference Include="AWSSDK.S3" Version="3.*" />

    <!-- Transactional Outbox -->
    <PackageReference Include="MediatR" Version="12.*" />

    <!-- Resiliency -->
    <PackageReference Include="Polly" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.*" />
  </ItemGroup>

</Project>
