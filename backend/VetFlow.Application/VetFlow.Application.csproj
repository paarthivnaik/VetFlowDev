<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VetFlow.Application</RootNamespace>
    <AssemblyName>VetFlow.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetFlow.Domain\VetFlow.Domain.csproj" />
    <ProjectReference Include="..\VetFlow.Shared\VetFlow.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CQRS / Mediator -->
    <PackageReference Include="MediatR" Version="12.*" />
    <!-- Validation -->
    <PackageReference Include="FluentValidation" Version="11.*" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.*" />
    <!-- Extensions -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.*" />
  </ItemGroup>

</Project>
