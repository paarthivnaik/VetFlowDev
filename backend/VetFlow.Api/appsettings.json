{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Platform": "Data Source=../.devdata/platform.db",
    "TenantTemplate": "Data Source=../.devdata/tenant-{0}.db"
  },
  "DatabaseProvider": "SQLite",
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/vetflow",
    "ClientId": "vetflow-api",
    "RequireHttpsMetadata": false
  }
}
