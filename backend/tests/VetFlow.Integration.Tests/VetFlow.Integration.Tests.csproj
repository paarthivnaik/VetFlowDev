<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>VetFlow.Integration.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VetFlow.Api\VetFlow.Api.csproj" />
    <ProjectReference Include="..\..\VetFlow.Application\VetFlow.Application.csproj" />
    <ProjectReference Include="..\..\VetFlow.Domain\VetFlow.Domain.csproj" />
    <ProjectReference Include="..\..\VetFlow.Infrastructure\VetFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\VetFlow.Shared\VetFlow.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="FluentAssertions" Version="6.*" />
    <!-- EF Core In-Memory for integration tests (SQLite in-memory) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
    <!-- ASP.NET Core test host -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <!-- Testcontainers for PostgreSQL integration tests -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.*" />
  </ItemGroup>

</Project>
