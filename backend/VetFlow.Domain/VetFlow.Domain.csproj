<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VetFlow.Domain</RootNamespace>
    <AssemblyName>VetFlow.Domain</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetFlow.Shared\VetFlow.Shared.csproj" />
  </ItemGroup>

  <!-- Domain has NO external package dependencies by design.
       Domain model, aggregates, value objects, and domain events
       must remain provider-independent (DATABASE-PROVIDER-POLICY). -->

</Project>
